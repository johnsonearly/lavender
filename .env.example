# Lavender runs fully in local demo mode (IndexedDB in the browser) when these are empty.

# --- Optional: Supabase backend (auth, Postgres, private image storage) ---
# Public project URL and anon key. The anon key is safe in the browser ONLY because
# row-level security policies in supabase/migrations restrict every table to its owner.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional: AI stylist (server-side only) ---
# Do NOT put LLM API keys in VITE_* variables. Set them as Supabase Edge Function secrets:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Then set this flag so the client calls the `stylist` edge function instead of the local engine.
VITE_ENABLE_REMOTE_STYLIST=false
